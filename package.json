      "name": "npm",
      "version": ">=12"
    },
    "runtime": [{
      "name": "node",
      "version": ">=26"
    }, {
      "name": "bun",
      "version": ">=1.4"
    }, {
      "name": "deno",
      "version": ">=2"
    }]
  }
}
