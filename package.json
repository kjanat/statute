{
  "name": "statute",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for the statute repo",
  "homepage": "https://github.com/kjanat/statute#readme",
  "bugs": "https://github.com/kjanat/statute/issues",
  "repository": "https://github.com/kjanat/statute",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:generate": "node scripts/wiki-sync.mjs docs wiki",
    "typecheck": "tsc --noEmit"
