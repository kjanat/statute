{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "main": {
      "packages": ["pkg:generic/go/statute.kjanat.dev"],
      "versionScope": "one-for-stream",
      "mustPublish": ["pkg:generic/go/statute.kjanat.dev"],
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "workflows": {
        "release": {
          "file": "release.yml",
          "mode": "observe",
          "ref": "refs/tags/v*",
          "publications": ["pkg:generic/go/statute.kjanat.dev"]
        },
        "pages": {
          "file": "pages.yml",
          "mode": "observe",
          "ref": "refs/tags/v*",
          "publications": []
        }
      },
      "promote": {
        "workflow": {
          "setup": {
            "job": "publish",
            "commands": "go vet ./...",
            "tagPrefix": "v"
          },
          "file": "tag-release.yml",
          "ref": "master",
          "publications": [],
          "refs": {
            "phase": "version",
            "prefix": "v"
          }
        }
      }
    }
  },
  "managers": ["go", "workflow"]
}
