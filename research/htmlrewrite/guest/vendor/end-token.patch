+
+    pub fn discard_inactive_tail(&mut self, idx: Locator) {
+        let index = locator_to_idx(idx);
+        // Stack retirement visits the explicit ancestor before its descendants.
+        // The first implicit handler discards itself and all deeper handlers;
+        // subsequent locators in that discarded tail need no further cleanup.
+        if index < self.items.len() {
+            debug_assert!(self.items[index..].iter().all(|item| item.user_count == 0));
+            self.items.truncate(index);
+        }
+    }
 }

