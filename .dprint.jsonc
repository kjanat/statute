{
  "markup": { "associations": ["!**/*.svg"] },
  "yaml": { "printWidth": 160 },
  "svg": { "associations": ["**/*.svg"] },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      { "command": "go tool goimports -local statute.kjanat.dev", "exts": ["go"], "cacheKeyFiles": ["go.mod"] }
    ],
  },
  "gofumpt": {
    "langVersion": "go1.27",
    "modulePath": "statute.kjanat.dev",
    "extra": { "groupParams": true }
  },
  "typescript": { "useTabs": true, "quoteStyle": "preferSingle" },
  "markdown": { "overrides": [{ "files": ["CHANGELOG.md"], "textWrap": "always", "lineWidth": 99999 }] },
  "plugins": [
    "npm:@dprint/dockerfile@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "https://plugins.dprint.dev/kjanat/svg-v0.4.1.wasm",
    "npm:@dprint/markdown@0.23.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.15",
    "npm:@dprint/typescript@0.96.1",
  ],
}
